package api

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"os"
	"slices"
	"strings"
	"testing"

	"github.com/widmogrod/mkunion/x/rpc"

	"{{.Module}}/api/resource/{{.Resource}}"
)

const token = "secret"

func newDeps() Deps {
	return Deps{
		{{.Type}}: &{{.Resource}}.Handler{Store: {{.Resource}}.NewMemoryStore()},
	}
}

func startServer(t *testing.T) (*httptest.Server, Deps) {
	t.Helper()
	deps := newDeps()
	ts := httptest.NewServer(New(Config{Token: token}, deps))
	t.Cleanup(ts.Close)
	return ts, deps
}

// clients is the generated clients of one resource over one transport.
type clients struct {
	query   {{.Resource}}.{{.Type}}QueryHandler
	command {{.Resource}}.{{.Type}}CommandHandler
}

// httpClients talks to ts over HTTP with a bearer token.
func httpClients(ts *httptest.Server, tok string) clients {
	return clients{
		query: {{.Resource}}.New{{.Type}}QueryClient(rpc.Client[{{.Resource}}.{{.Type}}Query, {{.Resource}}.{{.Type}}Answer](
			ts.Client(), ts.URL+"/v1/{{.Resource}}/query", rpc.Bearer(tok))),
		command: {{.Resource}}.New{{.Type}}CommandClient(rpc.Client[{{.Resource}}.{{.Type}}Command, {{.Resource}}.{{.Type}}Answer](
			ts.Client(), ts.URL+"/v1/{{.Resource}}/command", rpc.Bearer(tok))),
	}
}

// inProcessClients is the same clients on the endpoints' Send: no HTTP.
func inProcessClients(deps Deps) clients {
	return clients{
		query:   {{.Resource}}.New{{.Type}}QueryClient({{.Resource}}.QueryEndpoint(deps.{{.Type}}).Send),
		command: {{.Resource}}.New{{.Type}}CommandClient({{.Resource}}.CommandEndpoint(deps.{{.Type}}).Send),
	}
}

// assertClients is what any client of this server must see, over HTTP or not.
func assertClients(t *testing.T, c clients) {
	t.Helper()
	ctx := context.Background()
	created, err := rpc.Call(ctx, c.command, &{{.Resource}}.Create{{.Type}}{Title: "first"}) // created is *{{.Resource}}.{{.Type}}
	if err != nil || created.ID == "" || created.Title != "first" {
		t.Fatalf("create = %+v, %v", created, err)
	}
	got, err := rpc.Call(ctx, c.query, &{{.Resource}}.Get{{.Type}}{ID: created.ID})
	if err != nil || got.ID != created.ID {
		t.Fatalf("get = %+v, %v", got, err)
	}
	_, err = rpc.Call(ctx, c.query, &{{.Resource}}.Get{{.Type}}{ID: "missing"})
	var refused *{{.Resource}}.Error
	if !errors.As(err, &refused) || refused.Code != {{.Resource}}.ErrNotFound {
		t.Fatalf("unknown id: want Error{%s}, got %v", {{.Resource}}.ErrNotFound, err)
	}
}

func TestClientsOverHTTP(t *testing.T) {
	ts, _ := startServer(t)
	assertClients(t, httpClients(ts, token))
}

func TestClientsInProcess(t *testing.T) {
	assertClients(t, inProcessClients(newDeps()))
}

func TestWrongTokenIsRejected(t *testing.T) {
	ts, _ := startServer(t)
	_, err := rpc.Call(context.Background(), httpClients(ts, "wrong").query, &{{.Resource}}.Get{{.Type}}{ID: "1"})
	var status *rpc.StatusError
	if !errors.As(err, &status) || status.Status != http.StatusUnauthorized {
		t.Fatalf("wrong token: want HTTP 401, got %v", err)
	}
}

func TestBodyThatIsNotARequestIsBadRequest(t *testing.T) {
	ts, _ := startServer(t)
	req, _ := http.NewRequest(http.MethodPost, ts.URL+"/v1/{{.Resource}}/query", strings.NewReader(`{"$type":"{{.Resource}}.Nope","{{.Resource}}.Nope":{}}`))
	req.Header.Set("Authorization", "Bearer "+token)
	res, err := ts.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	var body map[string]any
	_ = json.NewDecoder(res.Body).Decode(&body)
	if res.StatusCode != http.StatusBadRequest || body["$type"] != "{{.Resource}}.Error" {
		t.Fatalf("unknown $type: want 400 with an Error, got %d %v", res.StatusCode, body)
	}
}

// catalogue is GET /v1 decoded: route -> the $type names it accepts.
func catalogue(t *testing.T, ts *httptest.Server) map[string][]string {
	t.Helper()
	req, _ := http.NewRequest(http.MethodGet, ts.URL+"/v1", nil)
	req.Header.Set("Authorization", "Bearer "+token)
	res, err := ts.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	var body struct {
		Accepts map[string][]string `json:"accepts"`
	}
	if err := json.NewDecoder(res.Body).Decode(&body); err != nil {
		t.Fatal(err)
	}
	return body.Accepts
}

func TestCatalogueNamesEveryRequest(t *testing.T) {
	ts, _ := startServer(t)
	acc := catalogue(t, ts)
	if !slices.Contains(acc["{{.Resource}}/query"], "{{.Resource}}.Get{{.Type}}") {
		t.Errorf("{{.Resource}}/query accepts %v, want {{.Resource}}.Get{{.Type}} among them", acc["{{.Resource}}/query"])
	}
	if !slices.Contains(acc["{{.Resource}}/command"], "{{.Resource}}.Create{{.Type}}") {
		t.Errorf("{{.Resource}}/command accepts %v, want {{.Resource}}.Create{{.Type}} among them", acc["{{.Resource}}/command"])
	}
}

// TestEveryResourceIsMounted reads api/resource/ and wants every package
// there to have a route in New. The fix is a mount line in server.go.
func TestEveryResourceIsMounted(t *testing.T) {
	ts, _ := startServer(t)
	acc := catalogue(t, ts)
	entries, err := os.ReadDir("resource")
	if err != nil {
		t.Fatal(err)
	}
	for _, e := range entries {
		if !e.IsDir() {
			continue
		}
		name := e.Name()
		_, hasQuery := acc[name+"/query"]
		_, hasCommand := acc[name+"/command"]
		if !hasQuery && !hasCommand {
			t.Errorf("resource %q has no route: add a %s field to Deps and mount(s, %q, %s.QueryEndpoint(deps.X)) in New (api/server.go), and build it in cmd/server/main.go",
				name, name, name+"/query", name)
		}
	}
}
